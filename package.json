{
  "name": "domotica-hogar-completa",
  "version": "1.0.0",
  "description": "Sistema Integral de Domótica, Gestión de Hogar, Comidas, Economía y Documentación (PWA Touch-First)",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev:server": "node server/index.js",
    "dev:client": "npm --prefix client run dev",
    "dev": "node server/index.js",
    "build": "npm --prefix client install --include=dev && npm --prefix client run build",
    "build:client": "npm --prefix client run build",
    "start": "node server/index.js",
    "start:lan": "npm --prefix client run build && node server/index.js",
    "install:all": "npm install && npm --prefix client install"
  },
  "engines": {
    "node": ">=18.0.0 <=22.x"
  },
  "keywords": [
    "domotica",
    "smart-home",
    "meal-planner",
    "finance",
    "pwa",
    "touch-first",
    "ewelink",
    "home-assistant",
    "render"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.23.0"
  }
}
